# Simulation build products and waveforms. Everything here is regenerated by
# `make -C sim test`; the screenshots that go in the report live in
# docs/waveforms/ and ARE committed.
sim/build/
sim/waves/
*.vvp
*.vcd
*.fst
*.lxt2
gtkwave.*

# Golden vectors are generated, but committed on purpose: tb_system.v compares
# against them, so the repository must hold the exact bytes the expectations
# were built from. Regenerate with `make -C sim vectors` - the seed is fixed, so
# a clean regeneration is byte-identical and shows no diff.
!sim/vectors/*.hex

# Synthesis. The reports are committed (results/synthesis_*.txt); the project
# directories a tool generates around them are not.
synth/
*.jou
*.str
vivado*.log
vivado*.jou
.Xil/
obj_dir/
yosys.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# LaTeX build products. The compiled PDF is NOT ignored - commit it on Monday
# as report/simd_vector_unit_phase1_report.pdf
report/build/
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc
report/*.log

# Video. Raw clips and project files are large and belong in Drive, not here -
# video/README.md holds the link. Only the link is committed.
video/*.mp4
video/*.mov
video/*.mkv
video/*.prproj
video/*.kdenlive

# OS / editor
.DS_Store
.vscode/
.idea/
*~

# Local copy of the team plan PDF
Project 11 SIMD Vector Unit Phase I Team Plan.pdf
